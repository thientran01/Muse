{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "server", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  // The throwaway fixture copy is a duplicate of e2e/fixture/ — typechecking it
  // would double every error and it does not exist on a clean checkout.
  "exclude": ["e2e/.tmp-fixture"]
}
