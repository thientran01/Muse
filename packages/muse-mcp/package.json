    "url": "git+https://github.com/thientran01/Muse.git",
    "directory": "packages/muse-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
