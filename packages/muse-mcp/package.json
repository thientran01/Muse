    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "muse",
    "claude",
    "design"
  ],
  "license": "MIT",
  "author": "Thien Tran",
