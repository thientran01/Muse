# The hosted demo build (`vite build --mode demo`). Committed — contains only
# public config and PUBLISHABLE keys (no secrets). Safe to ship in the bundle.
#
# MOCK: chat uses canned responses (no API key, no cost).
# EPHEMERAL: Canvas Mode edits apply in-browser only and reset on refresh.
VITE_MUSE_MOCK=1
VITE_MUSE_EPHEMERAL=1

# Feedback widget → Supabase. The anon/publishable key is meant to be public;
# access is enforced by row-level security (muse_feedback is insert-only, no read).
VITE_SUPABASE_URL=https://lvifnuladhwtmmhrntdp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_77orfj694pX3aVqrw-RGZw_OxntIVuM
